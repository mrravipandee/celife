# MongoDB connection URI (e.g., mongodb://localhost:27017/thedco)
MONGODB_URI=mongodb://localhost:27017/thedco

# Deployment Site URL (used for absolute SEO canonical links and sitemaps)
NEXT_PUBLIC_SITE_URL=https://thedco.com

# Authentication secret (used for cookie signing)
AUTH_SECRET=your-auth-secret-here

# Initial Admin credentials (used by scripts/create-admin.ts)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@thedco.com
ADMIN_PASSWORD=change-me-to-a-secure-password

# Cloudinary Media Configuration
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

